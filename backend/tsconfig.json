// TSD_Project/backend/tsconfig.json
{
  "compilerOptions": {
    "target": "es2021",
    "module": "commonjs", // <--- KEEP THIS AS COMMONJS FOR NODE.JS BACKEND
    "outDir": "../dist/backend", // Output to TSD_Project/dist/backend
    "rootDir": "./src",      // Source files are in backend/src
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": [
    "src/**/*.ts" // Only include backend source files
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts"
  ]
}